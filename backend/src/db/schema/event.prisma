model Event {
  id              Int          @id @default(autoincrement())
  title           String
  shortDesc       String
  longDesc        String
  location        String
  date            DateTime
  price           Float        @default(0.0)
  isFree          Boolean      @default(true)
  status          EventStatus  @default(SCHEDULED)
  category        Category
  maxAttendees    Int?

  creatorId       Int

  creator         User         @relation("CreatedEvents", fields: [creatorId], references: [id])
  attendees       Attendance[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  images          Image[]
}

enum Category {
  CONCERTS
  FESTIVALS
  THEMATIC_MEETINGS
  SPORTS
  NEIGHBORHOOD_GATHERINGS 
  BIRTHDAYS
  WEDDINGS
  CONFERENCES
  EXHIBITIONS
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}